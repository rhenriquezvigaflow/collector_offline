# Docker: sin secretos. configure.sh crea archivos en runtime/secrets (fuera de Git).
# Cambiar por la versión publicada en el repositorio privado. No usar latest.
COLLECTOR_IMAGE=ghcr.io/organizacion/collector-offline:0.1.0
POSTGRES_IMAGE=postgres:18.7-bookworm@sha256:1757c628698dd1ca67ff7a5fc386bfd91040afc62a45484c346c788b0cbe5402
COMPOSE_PROJECT_NAME=collector-offline
POSTGRES_DB=crystal_offline
APP_DB_USER=collector_local
TZ=America/Santiago
COLLECTOR_MEMORY=512m
POSTGRES_MEMORY=1g
COLLECTOR_CPUS=1.0
POSTGRES_CPUS=1.0
STOP_GRACE_PERIOD=180s
