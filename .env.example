# Ubuntu/systemd: socket local + autenticación peer del usuario collector_local.
COLLECTOR_OFFLINE_DATABASE_URL=postgresql+psycopg2:///crystal_offline

# Token exclusivo de este source_node_id, mínimo 24 caracteres. No reutilizar COLLECTOR_API_KEY.
COLLECTOR_OFFLINE_TOKEN=replace-with-a-random-node-token-at-least-32-chars

# Solo si small_sim.yml se configura con credenciales OPC UA por variables.
# SMALL_SIM_OPCUA_USERNAME=
# SMALL_SIM_OPCUA_PASSWORD=
